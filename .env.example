# Run npm run setup to generate a private .env and an empty database.
HOST=127.0.0.1
PORT=4000
DATA_DIR=./data
DATABASE_URL=file:../data/database/inkrail.db
OWNER_PASSWORD=
OWNER_SESSION_SECRET=
INKRAIL_ENABLE_TRANSLATION=false
TRANSLATION_WORKER_CONCURRENCY=1
TRANSLATION_TARGET_LANGUAGE=English
CODEX_TRANSLATION_MODEL=
CODEX_TRANSLATION_REASONING_EFFORT=low
INKRAIL_DISABLE_BACKGROUND_JOBS=false
