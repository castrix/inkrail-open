generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Novel {
  id                  String              @id @default(cuid())
  slug                String              @unique
  sourceSite          String              @default("twkan")
  sourceNovelId       String
  sourceUrl           String
  indexUrl            String
  titleOriginal       String
  titleTranslated     String?
  author              String?
  category            String?
  wordCountLabel      String?
  sourceStatus        String?
  description         String?
  coverUrl            String?
  coverPath           String?
  tagsJson            String?
  sourceLanguage      String              @default("zh-Hant")
  targetLanguage      String              @default("id")
  mediaType           String              @default("NOVEL")
  contentRating       String              @default("SAFE")
  sourceUpdatedAt     DateTime?
  lastScrapedAt       DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  chapters            Chapter[]
  scrapeJobs          ScrapeJob[]
  glossaryTerms       GlossaryTerm[]
  readingProgress     ReadingProgress?
  libraryEntries      LibraryNovel[]
  mangaPages          MangaPage[]
  encyclopediaEntries EncyclopediaEntry[]
  characterVisuals    CharacterVisualProfile[]
  syncSchedule        NovelSyncSchedule?

  @@unique([sourceSite, sourceNovelId])
  @@index([updatedAt])
}

model NovelSyncSchedule {
  id         String    @id @default(cuid())
  novelId    String    @unique
  novel      Novel     @relation(fields: [novelId], references: [id], onDelete: Cascade)
  enabled    Boolean   @default(true)
  localTime  String    @default("06:00")
  timezone   String    @default("Asia/Jakarta")
  nextRunAt  DateTime
  lastRunAt  DateTime?
  lastStatus String    @default("NOT_RUN")
  lastResult String?
  error      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([enabled, nextRunAt])
}

model MangaPage {
  id             String    @id @default(cuid())
  novelId        String
  novel          Novel     @relation(fields: [novelId], references: [id], onDelete: Cascade)
  sourcePageId   String
  sourceUrl      String
  position       Int
  thumbnailUrl   String?
  imagePath      String?
  downloadStatus String    @default("PENDING")
  error          String?
  downloadedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([novelId, sourcePageId])
  @@index([novelId, position])
  @@index([downloadStatus])
}

model Library {
  id        String         @id @default(cuid())
  name      String         @unique
  isDefault Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  novels    LibraryNovel[]

  @@index([isDefault])
}

model SourcePreference {
  sourceSite    String   @id
  lastLibraryId String
  updatedAt     DateTime @updatedAt
}

model LibraryNovel {
  id        String   @id @default(cuid())
  libraryId String
  library   Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  novelId   String
  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())

  @@unique([libraryId, novelId])
  @@index([novelId])
}

model Chapter {
  id                   String                @id @default(cuid())
  novelId              String
  novel                Novel                 @relation(fields: [novelId], references: [id], onDelete: Cascade)
  sourceChapterId      String
  sourceUrl            String
  position             Int
  titleOriginal        String
  titleTranslated      String?
  kind                 String                @default("UNKNOWN")
  sourcePath           String?
  sourceHash           String?
  sourcePublishedAt    DateTime?
  scrapeStatus         String                @default("PENDING")
  scrapeError          String?
  scrapedAt            DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  translations         Translation[]
  bookmarks            Bookmark[]
  progress             ReadingProgress[]
  encyclopediaMentions EncyclopediaMention[]
  encyclopediaScan     EncyclopediaScan?

  @@unique([novelId, sourceChapterId])
  @@index([novelId, position])
  @@index([scrapeStatus])
}

model EncyclopediaEntry {
  id             String                @id @default(cuid())
  novelId        String
  novel          Novel                 @relation(fields: [novelId], references: [id], onDelete: Cascade)
  type           String
  originalName   String
  translatedName String?
  aliasesJson    String                @default("[]")
  firstChapterId String
  firstPosition  Int
  locked         Boolean               @default(false)
  mentions       EncyclopediaMention[]
  visualProfile  CharacterVisualProfile?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([novelId, type, originalName])
  @@index([novelId, firstPosition])
}

model CharacterVisualProfile {
  id                      String             @id @default(cuid())
  novelId                 String
  novel                   Novel              @relation(fields: [novelId], references: [id], onDelete: Cascade)
  entryId                 String             @unique
  entry                   EncyclopediaEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  importanceScore         Float              @default(0)
  mentionedChapterCount   Int                @default(0)
  firstPosition           Int
  lastPosition            Int
  evidenceThroughPosition Int
  manuallyPinned          Boolean            @default(false)
  excluded                Boolean            @default(false)
  status                  String             @default("CANDIDATE")
  visualIdentityJson      String?
  error                   String?
  skinDetectionStatus     String             @default("NOT_STARTED")
  skinDetectionError      String?
  skinDetectedAt          DateTime?
  skins                   CharacterSkin[]
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([novelId, importanceScore])
  @@index([status])
}

model CharacterSkin {
  id                   String                 @id @default(cuid())
  profileId            String
  profile              CharacterVisualProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name                 String                 @default("First appearance")
  introducedAtPosition Int
  description          String?
  changeType           String                 @default("INITIAL")
  confidence           Float?
  evidenceJson         String                 @default("[]")
  detectionKey         String?                @unique
  origin               String                 @default("MANUAL")
  prompt               String
  imagePath            String?
  optimizedPath        String?
  fullBodyPath         String?
  fullBodyOptimizedPath String?
  status               String                 @default("PROPOSED")
  isDefault            Boolean                @default(false)
  error                String?
  generatedAt          DateTime?
  approvedAt           DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([profileId, introducedAtPosition])
  @@index([status])
}

model EncyclopediaMention {
  id              String            @id @default(cuid())
  entryId         String
  entry           EncyclopediaEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  chapterId       String
  chapter         Chapter           @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  chapterPosition Int
  description     String
  physicalDescription String @default("")
  sourceHash      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([entryId, chapterId])
  @@index([chapterId])
  @@index([entryId, chapterPosition])
}

model EncyclopediaScan {
  id              String   @id @default(cuid())
  chapterId       String   @unique
  chapter         Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  sourceHash      String
  translationHash String?
  identityVersion Int @default(1)
  status          String   @default("COMPLETED")
  error           String?
  scannedAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Translation {
  id              String    @id @default(cuid())
  chapterId       String
  chapter         Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  targetLanguage  String    @default("id")
  status          String    @default("NOT_STARTED")
  outputPath      String?
  sourceHash      String?
  translationHash String?
  provider        String?
  model           String?
  promptVersion   String?
  glossaryVersion Int?
  attempts        Int       @default(0)
  error           String?
  reviewNotes     String?
  translatedAt    DateTime?
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([chapterId, targetLanguage])
  @@index([status])
}

model ScrapeJob {
  id          String    @id @default(cuid())
  novelId     String?
  novel       Novel?    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  type        String
  status      String    @default("PENDING")
  payload     String?
  progress    Int       @default(0)
  total       Int       @default(0)
  priority    Int       @default(0)
  attempts    Int       @default(0)
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
}

model GlossaryTerm {
  id          String   @id @default(cuid())
  novelId     String
  novel       Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  source      String
  translation String
  category    String   @default("term")
  notes       String?
  locked      Boolean  @default(true)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([novelId, source])
}

model ReadingProgress {
  id        String   @id @default(cuid())
  novelId   String   @unique
  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  chapterId String
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  position  Float    @default(0)
  updatedAt DateTime @updatedAt
}

model Bookmark {
  id        String   @id @default(cuid())
  chapterId String
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  paragraph Int?
  note      String?
  createdAt DateTime @default(now())

  @@index([chapterId])
}

model ReaderSettings {
  id           Int      @id @default(1)
  theme        String   @default("sepia")
  fontFamily   String   @default("serif")
  fontSize     Int      @default(20)
  lineHeight   Float    @default(1.9)
  contentWidth Int      @default(760)
  readingMode  String   @default("translation")
  updatedAt    DateTime @updatedAt
}
